<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurante Phil - Cadastrar</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="login-body">

<div class="container">

    <div class="imagem">
        <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=900"
             alt="Hamburguer">
    </div>

    <div class="login-card">

        <h1>📝 Criar Conta</h1>
        <p>Cadastre um novo usuário no sistema</p>

        <% if (erro) { %>
            <div class="erro">
                <%= erro %>
            </div>
        <% } %>

        <form action="/register" method="POST">

            <label>Usuário</label>
            <input
                type="text"
                name="username"
                placeholder="Escolha seu usuário"
                required
            >

            <label>Senha</label>
            <input
                type="password"
                name="password"
                placeholder="Crie uma senha"
                required
            >

            <button type="submit">
                Cadastrar
            </button>

            <a href="/" class="btn-register">
                Já tem conta? Entrar
            </a>

        </form>

    </div>

</div>

</body>
</html>
